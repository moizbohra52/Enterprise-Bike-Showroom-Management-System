# ------------------------------------------------------------------
# Enterprise Bike Showroom - environment configuration
# Copy this file for each environment and pass values with --dart-define.
# NEVER commit real secrets. Use CI/CD secret stores in production.
#
# Example (development):
#   flutter run \
#     --dart-define=ENV=development \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ...anon...
# ------------------------------------------------------------------

ENV=development

# Supabase (project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Firebase is configured through platform files:
#   Android  -> android/app/google-services.json
#   iOS      -> ios/Runner/GoogleService-Info.plist
#   Web      -> firebase options object in lib/config/firebase_web_options.dart
# No Firebase secret is ever passed through --dart-define.
